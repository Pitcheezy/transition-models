        {
          "method": "HEAD",
          "path_template": "/",
          "expected_status": 200
        }
      ],
      "note": "Same no-User-Agent http.client and cookie as agreed; no exception inferred from this template"
    },
    {
      "id": "scope_negative",
      "owner": "Song",
      "service_cap": 1,
      "requests": [
        {
          "method": "HEAD",
          "path_template": "/_publish/v1/game/<key-plus-one>.json",
          "expected_status": 403
        }
      ],
