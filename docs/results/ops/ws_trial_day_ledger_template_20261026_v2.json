    },
    {
      "id": "expired",
      "owner": "Song",
      "service_cap": 1,
      "wait_for": "expiry passed; main stopped; no retries",
      "requests": [
        {
          "method": "HEAD",
          "path_template": "/_publish/v1/game/<key>.json",
          "expected_status": 403
        }
      ]
    },
    {
      "id": "revoked",
      "owner": "Song",
      "service_cap": 1,
      "wait_for": "host confirms digest rotation version; upload still ON",
      "requests": [
        {
          "method": "HEAD",
          "path_template": "/_publish/v1/game/<key>.json",
          "expected_status": 401
        }
      ]
    },
    {
      "id": "off",
      "owner": "Song",
      "service_cap": 1,
      "wait_for": "host confirms upload/read OFF version",
      "requests": [
        {
          "method": "HEAD",
          "path_template": "/_publish/v1/game/<key>.json",
          "expected_status": 503
        }
      ]
    },
    {
      "id": "viewer_revoke",
      "owner": null,
      "service_cap": null,
      "requests": [],
      "note": "Remove today viewer credential even without probe budget; HTTP401 is NOT_MEASURED unless separately agreed and run"
    }
  ],
