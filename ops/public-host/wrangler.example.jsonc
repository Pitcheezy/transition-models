{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitcheezy-ws-host-candidate",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DATA_READ_ENABLED": "false",
    "UPLOAD_ENABLED": "false",
    "READ_ORIGIN": ""
  },
  "r2_buckets": [
    { "binding": "PUBLISH_BUCKET", "bucket_name": "replace-with-dedicated-reviewed-bucket" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
