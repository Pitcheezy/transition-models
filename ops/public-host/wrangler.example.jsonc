{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitcheezy-ws-host-candidate",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DATA_READ_ENABLED": "false",
    "UPLOAD_ENABLED": "false",
    "READ_ORIGIN": "",
    "TELEMETRY_ENABLED": "false",
    "FEEDBACK_ENABLED": "false",
    "COLLECTION_ORIGIN": "",
    "TELEMETRY_RETAIN_DAYS": "30",
    "SESSION_WRITES_PER_DAY": "100000",
    "FEEDBACK_ROWS_PER_DAY": "5000"
  },
  "r2_buckets": [
    {
      "binding": "PUBLISH_BUCKET",
      "bucket_name": "replace-with-dedicated-reviewed-bucket"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "TELEMETRY_DB",
      "database_name": "replace-with-dedicated-private-db",
      "database_id": "replace-after-account-setup",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "TELEMETRY_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PUBLISH_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
